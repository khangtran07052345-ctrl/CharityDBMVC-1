@using System.Linq
@model IEnumerable<Charity.Models.Donation>
@{
    ViewBag.Title = "Quản lý quyên góp";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<div class="container mt-4 mb-5">
    <div class="d-flex justify-content-between align-items-center flex-wrap mb-3"><h2>Quản lý quyên góp</h2><div class="text-muted">Tổng tiền hợp lệ trong kết quả lọc: <strong>@(((decimal)ViewBag.ValidTotal).ToString("N0")) đ</strong></div></div>
    @using (Html.BeginForm("Donations", "Admin", FormMethod.Get, new { @class = "row g-2 mb-3" }))
    {
        <div class="col-md-7"><input class="form-control" name="keyword" value="@ViewBag.Keyword" placeholder="Mã giao dịch, tên người quyên góp hoặc chiến dịch..." /></div>
        <div class="col-md-3"><select class="form-select" name="status"><option value="">Tất cả trạng thái</option><option value="1" @(ViewBag.Status != null && (int)ViewBag.Status == 1 ? "selected" : "")>Hợp lệ</option><option value="0" @(ViewBag.Status != null && (int)ViewBag.Status == 0 ? "selected" : "")>Chưa xác nhận / không hợp lệ</option></select></div>
        <div class="col-md-2"><button class="btn btn-outline-primary w-100" type="submit">Lọc</button></div>
    }
    <div class="table-responsive">
        <table class="table table-striped table-hover align-middle">
            <thead class="table-dark"><tr><th>Mã giao dịch</th><th>Người quyên góp</th><th>Chiến dịch</th><th>Số tiền</th><th>Thời gian</th><th>Phương thức</th><th>Trạng thái</th></tr></thead>
            <tbody>
                @foreach (var d in Model)
                {
                    <tr><td>@(String.IsNullOrWhiteSpace(d.TransactionCode) ? "—" : d.TransactionCode)</td><td>@(d.IsAnonymous == true ? "Ẩn danh" : (d.User == null ? "Không rõ" : d.User.FullName))</td><td>@(d.Campaign == null ? "Không rõ" : d.Campaign.Title)</td><td class="text-nowrap">@d.Amount.ToString("N0") đ</td><td>@(d.DonatedAt.HasValue ? d.DonatedAt.Value.ToString("dd/MM/yyyy HH:mm") : "—")</td><td>@d.PaymentMethod</td><td>@if (d.Status == 1)
                    {<span class="badge bg-success">Hợp lệ</span> }
                    else
                    { <span class="badge bg-secondary">Chưa hợp lệ</span>}</td></tr>
}
                @if (!Model.Any())
                {
                    <tr><td colspan="7" class="text-center text-muted">Không tìm thấy khoản quyên góp.</td></tr>
}
            </tbody>
        </table>
    </div>
    <p class="small text-muted">Quy ước hiện tại: Donation có Status = 1 được tính vào tổng tiền nhận.</p>
    @Html.ActionLink("← Về Dashboard", "Index", "Admin", null, new { @class = "btn btn-outline-secondary" })
</div>
